# Run from this directory: lpc-rs-driver --env driver.env
# The filesystem root is relative to the process's working directory.
LPC_LIB_DIR=.
LPC_MASTER_OBJECT=/secure/master.c
LPC_SYSTEM_INCLUDE_DIRS=/include

# Listen locally; use 0.0.0.0 to accept connections on all IPv4 interfaces.
LPC_BIND_ADDRESS=127.0.0.1
LPC_PORT=24960

# ulib uses explicit includes and inherits, with no simulated efuns.
LPC_AUTO_INCLUDE_FILE=
LPC_AUTO_INHERIT_FILE=
LPC_SIMUL_EFUN_FILE=

# Fifteen minutes without a complete input line disconnects a guest.
LPC_MAX_IDLE_TIME=900
LPC_SERVER_LOG_FILE=STDOUT
LPC_DEBUG_LOG_FILE=STDOUT
LPC_RUST_LOG=info
